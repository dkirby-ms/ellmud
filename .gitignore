# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# TypeScript build output (config files)
*.config.js
*.config.js.map
*.config.d.ts
*.config.d.ts.map
vitest.workspace.js
vitest.workspace.js.map
vitest.workspace.d.ts
vitest.workspace.d.ts.map

# Compiled output in src/ directories (TypeScript composite/declaration artifacts)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map

# Compiled scripts
scripts/**/*.js
scripts/**/*.js.map
scripts/**/*.d.ts
scripts/**/*.d.ts.map

# Environment
.env
.env.local
.env.*.local

# Coverage
coverage/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Sandbox scenario data (user-created; .gitkeep is tracked)
packages/server/data/sandbox-scenarios/*.json

# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Sandbox test scenario files
packages/server/data/.test-sandbox-scenarios/
test-results/
.squad/.cache/
