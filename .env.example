# ──────────────────────────────────────────────────
# Entra External ID OAuth Configuration
# Get these values from your Entra External ID tenant app registration
# ──────────────────────────────────────────────────
ENTRA_CLIENT_ID=your-entra-client-id
ENTRA_CLIENT_SECRET=your-entra-client-secret
ENTRA_TENANT_ID=your-entra-tenant-id

# Entra External ID (CIAM) tenant subdomain — the custom domain name, NOT the GUID.
# Find it in: Entra admin > Tenant overview > "Primary domain" (e.g. "ellmud" from ellmud.ciamlogin.com)
ENTRA_TENANT_SUBDOMAIN=your-tenant-subdomain

# OAuth callback URL (must match redirect URI in Entra app registration)
# For local dev: http://localhost:3000/auth/entra/callback
# For production: https://your-domain.azurecontainerapps.io/auth/entra/callback
ENTRA_REDIRECT_URI=http://localhost:3000/auth/entra/callback

# Allow local username/password authentication (true for dev, false for prod)
ALLOW_LOCAL_AUTH=true

# Require authentication to join game rooms (default: true)
# Set to false only for integration tests that need anonymous room access.
AUTH_REQUIRED=true

# Client URL (used for CORS and OAuth redirect back to the browser)
CLIENT_URL=http://localhost:5173

# ──────────────────────────────────────────────────
# Database & Redis
# ──────────────────────────────────────────────────

# PostgreSQL connection string (docker-compose exposes 5434→5432)
DATABASE_URL=postgresql://ellmud:ellmud_dev@localhost:5434/ellmud

# Redis — narration cache + Colyseus presence for multi-replica scaling
REDIS_PRESENCE_ENABLED=true
REDIS_CACHE_ENABLED=true
# REDIS_DRIVER_ENABLED=true
# REDIS_CONNECTION_STRING=redis://localhost:6379

# ──────────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────────

# Server listen port (default: 2567)
# PORT=2567

# Admin dashboard token (protects /admin API endpoints; fail-closed when unset)
ADMIN_TOKEN=ellmud-admin-dev

# Enable /peaceful command and other dev tools (default: false)
DEV_MODE_ENABLED=true

# ──────────────────────────────────────────────────
# LLM Narration (optional — template-only mode when no credentials are set)
# ──────────────────────────────────────────────────

# OpenAI-compatible endpoint (OpenAI, Azure OpenAI, LM Studio, Ollama, Mistral, etc.)
# OPENAI_LLM_ENDPOINT=https://api.openai.com
# OPENAI_LLM_KEY=your-api-key
# OPENAI_LLM_MODEL=gpt-4o

# Explicit toggle — set false to force template-only mode even with credentials
# ENABLE_LLM_NARRATION=true

# ──────────────────────────────────────────────────
# Client (Vite — VITE_ prefix required for browser exposure)
# ──────────────────────────────────────────────────

# Auto-login with dev/devdev credentials in Vite dev mode (default: unset/false)
# Set to true only when you don't need to test the login flow.
# VITE_DEV_AUTO_LOGIN=true
