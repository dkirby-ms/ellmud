      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COALESCE(NULLIF(metadata->>'roomId', ''), 'unknown') AS \"Room ID\",\n  COUNT(*) AS \"Deaths\",\n  COUNT(DISTINCT player_id) AS \"Unique Players\"\nFROM game_metrics\nWHERE $__timeFilter(created_at)\n  AND event_type = 'death'\nGROUP BY 1\nORDER BY \"Deaths\" DESC, \"Room ID\" ASC\nLIMIT 10;",
          "refId": "A"
        }
      ],
