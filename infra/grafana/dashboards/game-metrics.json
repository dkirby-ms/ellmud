          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  player_id AS \"Player ID\",\n  COUNT(*) AS \"Kills\"\nFROM game_metrics\nWHERE event_type = 'kill'\n  AND created_at >= NOW() - INTERVAL '24 hours'\nGROUP BY player_id\nORDER BY \"Kills\" DESC, \"Player ID\" ASC\nLIMIT 10;",
          "refId": "A"
        }
      ],
      "title": "Top killers leaderboard",
      "type": "table"
