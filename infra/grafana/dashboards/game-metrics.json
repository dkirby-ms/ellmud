      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(created_at, '1h'),\n  COALESCE(NULLIF(metadata->>'source', ''), 'unknown') AS metric,\n  COUNT(*)::double precision AS value\nFROM game_metrics\nWHERE $__timeFilter(created_at)\n  AND event_type = 'loot_pickup'\nGROUP BY 1, 2\nORDER BY 1, 2;",
          "refId": "A"
        }
      ],
      "title": "Loot activity",
      "type": "timeseries"
