          ],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_POSTGRESQL}"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroupAlias(created_at, '1h'),\n  CASE\n    WHEN COALESCE((metadata->>'isCreature')::boolean, false) THEN 'Creature kills'\n    ELSE 'Player kills'\n  END AS metric,\n  COUNT(*)::double precision AS value\nFROM game_metrics\nWHERE $__timeFilter(created_at)\n  AND event_type = 'kill'\nGROUP BY 1, 2\nORDER BY 1, 2;",
          "refId": "A"
        }
      ],
      "title": "Kills over time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_POSTGRESQL}"
      },
      "description": "Loot pickups over time, grouped by pickup source.",
      "fieldConfig": {
